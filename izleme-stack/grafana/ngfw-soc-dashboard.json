{
  "__comment_path": "izleme-stack/grafana/ngfw-soc-dashboard.json",
  "title": "AegisNova Global - 4 Şube NGFW, Bant Genişliği ve SOC İzleme Panosu",
  "uid": "aegisnova-ngfw-soc-v1",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Şube Bazlı Anlık WAN Kullanımı (Mbps) vs Kurulu Kapasite",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "aegisnova_ngfw_wan_throughput_mbps",
          "legendFormat": "{{branch}} ({{model}})"
        }
      ]
    },
    {
      "id": 2,
      "title": "Aktif Eşzamanlı Oturum Sayısı (Akademik 10.000 Öğrenci + Ofisler)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "aegisnova_ngfw_active_sessions",
          "legendFormat": "{{branch}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Güvenlik Duvarı Engellenen Tehdit ve Politika İhlalleri (DENY/DROP)",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum by (branch, reason) (aegisnova_ngfw_denied_packets_total)",
          "legendFormat": "{{branch}} - {{reason}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Active-Passive HA Küme Sağlığı ve DataPlane CPU (%)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "aegisnova_ngfw_dataplane_cpu_percent",
          "legendFormat": "{{branch}} CPU %"
        }
      ]
    }
  ]
}

