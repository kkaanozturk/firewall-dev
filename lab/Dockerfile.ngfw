# Path: lab/Dockerfile.ngfw
# AegisNova Global - Gerçek Linux Çekirdeği (nftables + tc HTB QoS) Laboratuvar Düğümü İmajı

FROM alpine:3.20

RUN apk add --no-cache \
    bash \
    nftables \
    iproute2 \
    iptables \
    curl \
    netcat-openbsd \
    iperf3 \
    tcpdump \
    python3 \
    iputils

COPY subeler/ /opt/aegisnova/subeler/
COPY lab/scripts/ /opt/aegisnova/scripts/

RUN chmod +x /opt/aegisnova/scripts/*.sh /opt/aegisnova/subeler/*/configs/*.sh

CMD ["sleep", "infinity"]

